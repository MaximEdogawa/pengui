# ===========================================
# Pengui App Deployment Configuration
# ===========================================
# App only - the relay deploys completely separately, see
# deployment/splash-relay/.env.example and deployment/README.md.
#
# Deployment itself is driven by ONCE (https://github.com/basecamp/once) on the
# server - it doesn't read this file. These are the build-time/runtime values CI
# needs (as GitHub Actions secrets/variables) and what `once deploy` expects.

# ----- Domain (ONCE: one hostname per app, TLS is automatic) -----
DOMAIN=pengui.space

# ----- Docker image (built by CI, pulled by ONCE) -----
APP_IMAGE=ghcr.io/maximedogawa/pengui:latest

# ----- GitHub Container Registry (only needed for manual image builds/pushes) -----
GITHUB_USERNAME=your-github-username
GITHUB_ACTOR=your-github-username
GITHUB_TOKEN=your-personal-access-token

# ----- Application Environment -----
NODE_ENV=production

# ----- WalletConnect Configuration -----
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id
NEXT_PUBLIC_WALLET_CONNECT_RELAY_URL=wss://relay.walletconnect.com

# ----- API Configuration -----
NEXT_PUBLIC_DEXIE_MAINNET_API_URL=https://api.dexie.space
NEXT_PUBLIC_DEXIE_TESTNET_API_URL=https://api-testnet.dexie.space

# ----- Splash relay (Stream tab auto-connect) -----
# Set at app build time so the app connects via wss to the relay's ONCE hostname
# (relay is deployed separately - see deployment/splash-relay/.env.example).
# NEXT_PUBLIC_DEXIE_SPLASH_RELAY_WS_URL=wss://relay.pengui.space
# NEXT_PUBLIC_DEXIE_SPLASH_RELAY_MAINNET_WS_URL=wss://relay.pengui.space

# ----- Public URLs -----
NEXT_PUBLIC_API_BASE_URL=https://pengui.space/api
NEXT_PUBLIC_APP_URL=https://pengui.space
NEXT_PUBLIC_APP_VERSION=1.0.0

# ----- Feature Flags -----
# Comma-separated list of enabled features (passed as Docker build arg).
# Available: dashboard, offers, trading, loans, optionContracts, piggyBank, wallet
NEXT_PUBLIC_FEATURE_FLAGS=dashboard,offers,trading,wallet
