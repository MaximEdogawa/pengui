
# GitHub Container Registry Authentication
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=your-personal-access-token

#Docker 
DOCKER_IMAGE=ghcr.io/pengui:latest
DOMAIN=your-domain
EMAIL=your-email
STAGING=0

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=deployment

# WalletConnect Configuration
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_actual_project_id   
NEXT_PUBLIC_WALLET_CONNECT_RELAY_URL=wss://relay.walletconnect.com

# API Configuration
NEXT_PUBLIC_DEXIE_MAINNET_API_URL=https://api.dexie.space
NEXT_PUBLIC_DEXIE_TESTNET_API_URL=https://api-testnet.dexie.space

# Server Configuration
NEXT_PUBLIC_API_BASE_URL=your-domain/api
NEXT_PUBLIC_APP_URL=your-domain