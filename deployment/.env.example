# ===========================================
# Pengui Deployment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Or set these as GitHub Secrets for CI/CD deployment

# ----- Domain & SSL Configuration -----
DOMAIN=pengui.example.com
EMAIL=admin@example.com
# Set to 1 for Let's Encrypt staging (testing), 0 for production
STAGING=0

# ----- Docker Configuration -----
# Always prefer a fixed version tag for reproducible deployments,
# e.g. ghcr.io/maximedogawa/pengui:v1.2.3
DOCKER_IMAGE=ghcr.io/maximedogawa/pengui:v1.0.0

# Nginx exits and restarts with Docker when splash-relay stops (1=on). Use 0 only for debugging without relay.
RELAY_WATCHDOG=1

# Relay logging: info (default), debug for verbose libp2p/Dexie logs during troubleshooting
# RUST_LOG=debug

# ----- GitHub Container Registry -----
# Only needed for manual deployment
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=your-personal-access-token

# ----- Application Environment -----
NODE_ENV=production

# ----- WalletConnect Configuration -----
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id
NEXT_PUBLIC_WALLET_CONNECT_RELAY_URL=wss://relay.walletconnect.com

# ----- API Configuration -----
NEXT_PUBLIC_DEXIE_MAINNET_API_URL=https://api.dexie.space
NEXT_PUBLIC_DEXIE_TESTNET_API_URL=https://api-testnet.dexie.space

# ----- Pengine web (optional, separate deployment) -----
# Pengine runs on the same host via its own docker compose; publish host port 1422 (see pengine deployment/docker-compose.yml).
# Pengui nginx proxies with http://host.docker.internal:1422 — see deployment/README.md ("Pengine behind Pengui nginx").
# Path: https://$DOMAIN/pengine/  OR set a dedicated hostname (production Pengine):
# PENGINE_SUBDOMAIN=pengine.net
# Add a DNS A record for pengine.net → this server, then include it in cert (deploy.sh adds -d).

# ----- Splash relay (Stream tab auto-connect) -----
# Set these when running splash-relay so the app connects via wss. Use relay subdomain from DNS.
# NEXT_PUBLIC_DEXIE_SPLASH_RELAY_WS_URL=wss://relay.penguinpool.space
# NEXT_PUBLIC_DEXIE_SPLASH_RELAY_MAINNET_WS_URL=wss://relay.penguinpool.space

# ----- Public URLs -----
NEXT_PUBLIC_API_BASE_URL=https://pengui.example.com/api
NEXT_PUBLIC_APP_URL=https://pengui.example.com
NEXT_PUBLIC_APP_VERSION=1.0.0

# ----- Feature Flags -----
# Comma-separated list of enabled features (passed as Docker build arg).
# Available: dashboard, offers, trading, loans, optionContracts, piggyBank, wallet
NEXT_PUBLIC_FEATURE_FLAGS=dashboard,offers,trading,wallet
