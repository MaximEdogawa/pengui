# Environment variables for Pengui production
# Copy this file to .env.production and fill in the actual values

# Application Version (set automatically by deployment pipeline)
# APP_VERSION=v1.0.0

# Node environment
NODE_ENV=production

# Application port
PORT=3000

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1

# Database (if needed)
# DATABASE_URL=postgresql://user:password@host:5432/pengui

# API Configuration
# NEXT_PUBLIC_API_URL=https://api.example.com

# Authentication (if needed)
# AUTH_SECRET=your-secret-key-here

# Feature flags
# NEXT_PUBLIC_FEATURE_FLAG_BETA=false

# Analytics (if needed)
# NEXT_PUBLIC_ANALYTICS_ID=

# Add other environment variables below as needed
