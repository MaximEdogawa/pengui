# Use Docker's internal DNS resolver for dynamic resolution
# - valid=30s: Cache DNS for 30 seconds (balance between performance and failover)
# - ipv6=off: Disable IPv6 to avoid resolution delays in Docker networks
resolver 127.0.0.11 valid=30s ipv6=off;
resolver_timeout 5s;

# Map for WebSocket connection upgrade
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    server_name _;
    
    # ACME challenge for Let's Encrypt SSL certificate
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }
    
    # Health check endpoint for Docker/load balancer
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
    
    # Static files - larger buffers
    location /_next/static/ {
        set $backend "http://pengui:3000";
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        
        # Larger buffers for static JS/CSS files
        proxy_buffer_size 128k;
        proxy_buffers 16 256k;
        proxy_busy_buffers_size 512k;
    }
    
    # Public static files (images, etc.)
    location ~* \.(jpg|jpeg|png|gif|ico|svg|webp|woff|woff2|ttf|eot)$ {
        set $backend "http://pengui:3000";
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        
        # Larger buffers for images/fonts
        proxy_buffer_size 128k;
        proxy_buffers 16 256k;
        proxy_busy_buffers_size 512k;
    }
    
    # Proxy all requests to Next.js
    location / {
        # Use variable to force DNS re-resolution
        set $backend "http://pengui:3000";
        proxy_pass $backend;
        
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # Timeouts
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Retry on connection failure (helps during container restart)
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
        proxy_next_upstream_timeout 15s;
        
        # Larger buffers to avoid temp file buffering
        proxy_buffer_size 128k;
        proxy_buffers 8 256k;
        proxy_busy_buffers_size 512k;
        
        # Intercept errors for better handling
        proxy_intercept_errors on;
        error_page 502 503 504 @fallback;
    }
    
    # Fallback location - retry after a brief delay
    location @fallback {
        internal;
        default_type text/html;
        return 503 '<!DOCTYPE html>
<html>
<head>
    <title>Loading...</title>
    <meta http-equiv="refresh" content="2">
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
               display: flex; justify-content: center; align-items: center; height: 100vh; 
               margin: 0; background: #0f172a; color: #e2e8f0; }
        .loader { text-align: center; }
        .spinner { width: 40px; height: 40px; border: 3px solid #334155; 
                   border-top-color: #3b82f6; border-radius: 50%; 
                   animation: spin 1s linear infinite; margin: 0 auto 20px; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="loader">
        <div class="spinner"></div>
        <p>Connecting to server...</p>
    </div>
</body>
</html>';
    }
}
