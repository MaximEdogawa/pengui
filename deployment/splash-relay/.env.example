# ===========================================
# Pengui Relay Deployment Configuration
# ===========================================
# Relay only - the app deploys completely separately, see
# deployment/.env.example and deployment/README.md.
#
# Deployment itself is driven by ONCE (https://github.com/basecamp/once) on the
# server - it doesn't read this file. These are the build-time/runtime values CI
# needs (as GitHub Actions secrets/variables) and what `once deploy` expects.

# ----- Domain (ONCE: one hostname per app, TLS is automatic) -----
DOMAIN=pengui.space
# RELAY_MAINNET_SUBDOMAIN=relay.pengui.space          # default: relay.$DOMAIN
# RELAY_TESTNET_SUBDOMAIN=relay-testnet.pengui.space  # default: relay-testnet.$DOMAIN

# ----- Docker image (built by CI, pulled by ONCE) -----
RELAY_IMAGE=ghcr.io/maximedogawa/pengui:splash-relay

# ----- Relay runtime config (env vars read by deployment/splash-relay/entrypoint.sh) -----
RELAY_TCP_PORT=11511
RELAY_WS_PORT=9090
# RELAY_TESTNET=1
# RELAY_MAX_WS_CONNECTIONS=500
# RELAY_KNOWN_PEERS=

# Relay logging: info (default), debug for verbose libp2p/Dexie logs during troubleshooting
# RUST_LOG=debug

# ----- GitHub Container Registry (only needed for manual image builds/pushes) -----
GITHUB_USERNAME=your-github-username
GITHUB_ACTOR=your-github-username
GITHUB_TOKEN=your-personal-access-token
