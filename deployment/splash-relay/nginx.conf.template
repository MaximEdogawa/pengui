worker_processes 1;
events { worker_connections 1024; }

http {
    # ONCE (https://github.com/basecamp/once) requires apps to serve plain
    # HTTP on port 80 with a `/up` health check; splash-relay itself only
    # speaks libp2p/WebSocket. This shim satisfies that contract and proxies
    # everything else straight through to the relay's WebSocket listener.
    server {
        listen 80;

        location = /up {
            return 200;
        }

        location / {
            proxy_pass http://127.0.0.1:__WS_PORT__;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400;
        }
    }
}
