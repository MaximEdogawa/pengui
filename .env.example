# GitHub Container Registry Authentication
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=your-personal-access-token

# Application
NODE_ENV=production
# Environment for info banner display: demo, alpha, beta, or production
# - demo/alpha/beta: Banner always visible, non-dismissible
# - production: Banner dismissible, only shows for new versions/announcements
NEXT_PUBLIC_APP_ENV=production

# WalletConnect Configuration
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_actual_project_id
NEXT_PUBLIC_WALLET_CONNECT_RELAY_URL=wss://relay.walletconnect.com

# SpaceScan API (optional overrides — defaults are correct for mainnet + testnet11)
# NEXT_PUBLIC_SPACESCAN_API_URL=https://api.spacescan.io
# NEXT_PUBLIC_SPACESCAN_TESTNET_API_URL=https://api-testnet11.spacescan.io

# API Configuration
NEXT_PUBLIC_DEXIE_MAINNET_API_URL=https://api.dexie.space
NEXT_PUBLIC_DEXIE_TESTNET_API_URL=https://api-testnet.dexie.space

# Tibet Swap (v2) API — read in client via process.env (see src/features/tibet-swap/lib/tibetApiBaseUrl.ts)
# Backs the Swap / Add liquidity / Remove liquidity tab. Tibet v2 serves mainnet
# and testnet from the same endpoint, so the testnet URL is intentionally identical.
NEXT_PUBLIC_TIBET_API_URL=https://api.v2.tibetswap.io
NEXT_PUBLIC_TIBET_MAINNET_API_URL=https://api.v2.tibetswap.io
NEXT_PUBLIC_TIBET_TESTNET_API_URL=https://api.v2.tibetswap.io

# Dexie Splash relay (libp2p WebSocket) for Stream tab live offers
# Run splash-relay locally: `bun run relay` (mainnet, ws://localhost:9090) or
# `bun run relay:testnet` (testnet, ws://localhost:9091). In production it's
# deployed as an ONCE app — see deployment/README.md.
NEXT_PUBLIC_DEXIE_SPLASH_RELAY_WS_URL=ws://localhost:9090
NEXT_PUBLIC_DEXIE_SPLASH_RELAY_MAINNET_WS_URL=wss://relay.pengui.space
NEXT_PUBLIC_DEXIE_SPLASH_RELAY_TESTNET_WS_URL=ws://localhost:9091

# Server Configuration
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com/api
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Feature Flags — comma-separated list of enabled features
# Available: dashboard, offers, trading, loans, optionContracts, piggyBank, wallet
# Unset or blank falls back to the baseline dashboard,offers,trading,wallet.
# Swap (incl. add/remove liquidity) has no flag of its own: it ships with `trading`.
NEXT_PUBLIC_FEATURE_FLAGS=dashboard,offers,trading,loans,optionContracts,piggyBank,wallet

