#!/usr/bin/env bash

set -e
set -o pipefail

echo "🔍 Running pre-commit checks..."

echo "📝 Linting staged files..."
bun run lint

echo "🧪 Running unit tests..."
bun run test:unit

echo "🔗 Running integration tests..."
bun run test:integration

echo "🏗️  Building project..."
bun run build

echo "✅ All pre-commit checks passed!"

