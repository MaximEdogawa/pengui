{
  "name": "pengui",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "bun next dev",
    "build": "bun next build",
    "build:wasm": "bun run scripts/build-wasm.ts",
    "build:all": "bun run build:wasm && bun run build:relay && bun run build",
    "build:relay": "cargo build --release --manifest-path crates/splash-relay/Cargo.toml",
    "relay": "cd crates/splash-relay && cargo run --release --",
    "relay:debug": "cd crates/splash-relay && RUST_LOG=debug cargo run --release --",
    "relay:testnet": "cd crates/splash-relay && cargo run --release -- --testnet --ws-port 9091 --tcp-port 11512",
    "relay:testnet:debug": "cd crates/splash-relay && RUST_LOG=debug cargo run --release -- --testnet --ws-port 9091 --tcp-port 11512",
    "start": "bun next start",
    "lint": "bun eslint . --config eslint.config.mjs --max-warnings=1000",
    "type-check": "bunx tsc --noEmit",
    "test:unit": "bun test src/shared src/features src/entities src/widgets",
    "test:integration": "bun test src/tests/integration/**/*.test.{ts,tsx}",
    "test:ct": "playwright test --config playwright-ct.config.ts",
    "test:ct:ui": "playwright test --config playwright-ct.config.ts --ui",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e && bun run test:ct",
    "test:api-proxy": "bun run scripts/test-api-proxy.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@maximedogawa/chia-wallet-connect-react": "^0.0.5",
    "@playwright/experimental-ct-react": "^1.59.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.2.1",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^1.7.0",
    "next": "^16.1.1",
    "next-themes": "^0.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-redux": "^9.2.0",
    "recharts": "^3.7.0",
    "redux-persist": "^6.0.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.91.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.19.28",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "baseline-browser-mapping": "^2.9.14",
    "bun-types": "^1.3.6",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "wasm-pack": "^0.15.0"
  },
  "trustedDependencies": [
    "wasm-pack"
  ]
}
